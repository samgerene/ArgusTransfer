<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.1</Version>
        <LangVersion>14.0</LangVersion>
        <Company>Sam Gerené</Company>
        <Authors>Sam Gerené</Authors>
        <Copyright>Copyright © Sam Gerené</Copyright>
        <PackageId>ArgusTransfer</PackageId>
        <AssemblyTitle>ArgusTransfer</AssemblyTitle>
        <Title>Argus Transfer</Title>
        <Description>Argus Transfer is framework that provides routing for named pipes inspired by the HTTP 1.1 request/response protocol that runs over named pipes layer.</Description>
        <RequireLicenseAcceptance>true</RequireLicenseAcceptance>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <IncludeSource>true</IncludeSource>
        <IncludeSymbols>true</IncludeSymbols>
        <RepositoryUrl>https://github.com/samgerene/ArgusTransfer</RepositoryUrl>
        <RepositoryType>Git</RepositoryType>
        <NeutralLanguage>en-US</NeutralLanguage>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>argus-transfer-ico.png</PackageIcon>
        <PackageTags>pipe routing argus protocol</PackageTags>
        <PackageReleaseNotes>
            [Security]
            - Hardened chunked transfer encoding against DoS: chunk size parsing now uses TryParse with non-negative
            validation to prevent malicious peers from triggering excessive memory allocation
            - Added non-negative validation for parsed Content-Length headers in both request and response
            deserializers
            - Added ObjectDisposedException guard in ArgusClient.SendAsync to fail fast after disposal
            - Fixed resource leak in ArgusClient.SendAsync: StreamWriter and StreamReader are now properly disposed
            with leaveOpen: true

            [Performance]
            - Replaced Substring().Trim() with AsSpan().Trim().ToString() in header parsing hot paths to reduce
            intermediate string allocations
            - Replaced ContainsKey + indexer double lookup with TryGetValue in ArgusBodySerializerRegistry
            - Cached JsonSerializerOptions instance in SampleClientService instead of allocating per call
            - Used ReadAsync(Memory byte) overload instead of inexact Read(byte[], int, int) in chunked encoding

            [Refactoring]
            - Introduced ArgusHeaderNames constants (Accept, ContentType, ContentLength, CorrelationToken, Timestamp)
            replacing all string literals
            - Reordered IArgusClient and ArgusClient method overloads to be adjacent by name
            - Reordered ArgusResponseSerializer so all Write overloads are grouped, followed by all WriteAsync
            overloads
            - Refactored GuidExtensions.FromShortGuidArray to use a private iterator method
            - Refactored ArgusClient.SendAsync to use requestSerializer.WriteAsync
        </PackageReleaseNotes>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>ArgusTransfer</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <GenerateSBOM>true</GenerateSBOM>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\argus-transfer-ico.png" Pack="true" PackagePath="" />
        <InternalsVisibleTo Include="ArgusTransfer.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.5" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    </ItemGroup>

</Project>
